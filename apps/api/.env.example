# API Environment Variables — copy to .env and fill in values
# See ENVIRONMENT_SETUP.md for full details

NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://stocksense:stocksense_dev@localhost:5432/stocksense"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Phase 1.3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# NVIDIA NIM (Phase 1.8 / 1.9)
# NIM_MODE=cloud                         # "cloud" | "local"
# NIM_API_KEY=                           # required when NIM_MODE=cloud
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1   # cloud default; use http://localhost:8000/v1 for local
# NIM_RESEARCH_MODEL=meta/llama-3.1-70b-instruct     # model used for stock research (1.9)
# NIM_CHAT_MODEL=meta/llama-3.1-8b-instruct          # model used for chat (1.11)

# Market Data Provider (Phase 1.4)
# MARKET_DATA_PROVIDER=mock   # "mock" | "alpha_vantage" | "twelve_data"
# ALPHA_VANTAGE_API_KEY=
# TWELVE_DATA_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173
